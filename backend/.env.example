# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required -------------------------------------------------------------

# Groq API key (quiz, notes, chat): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# Signs the step tokens; 32+ random characters. Generate: openssl rand -hex 32
SECRET=change_me_to_a_long_random_string

# PostgreSQL. Docker Compose creates the database from these values and overrides
# DB_HOST to "postgres"; keep localhost for running the backend natively.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_summarizer
DB_USER=postgres
# Required by Docker Compose. Generate: openssl rand -hex 16
DB_PASSWORD=change_me

# Frontend URL(s) allowed to call the API, comma-separated, https and no trailing slash
# e.g. https://vnotes.vercel.app,https://vnotes.app
ALLOWED_ORIGINS=http://localhost:3000

# --- YouTube downloads ----------------------------------------------------

# Rotating residential proxy for yt-dlp. Needed on cloud servers (YouTube blocks
# datacenter IPs); leave empty locally. Keep {session} as is: it's replaced with a
# fresh id per download so the provider keeps one IP for the whole download.
YTDLP_PROXY=
# YTDLP_PROXY=http://username-session-{session}:password@gateway.example.com:7000

# Max seconds per download attempt
YTDLP_TIMEOUT_SECONDS=1200

# --- Optional -------------------------------------------------------------

# Serve the API docs at /docs (off by default)
# ENABLE_DOCS=1

# Outside Docker Compose only: trust X-Forwarded-For so the rate limit sees real
# client IPs. Set to * only when the backend is reachable solely through your proxy.
# FORWARDED_ALLOW_IPS=*
